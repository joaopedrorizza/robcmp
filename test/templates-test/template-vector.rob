
template <typename J>
void sort(J arr, int8 n) {
	i = 0;
while (i < n) {
    j = 0;
    y = n - 1;

    while (j < y) {
        s = j+1;
        
        if (arr[j] > arr[s]){
            temp = arr[j];
            arr[j] = arr[j+1];
            arr[j+1] = temp;
        }
        j++;
        i++;
}}}

int16 main() {
	a = {34, -5, 6, 0, 12, 100, 56, 22, 44, -3, -9, 12, 17, 22, 6, 11};
	r = {-9, -5, -3, 0, 6, 6, 11, 12, 12, 17, 22, 22, 34, 44, 56, 100};

    i = 0;

    sort#int8[](a);

    while i < 16 {
        if(a[i] != r[15-i]) {
            return 1;
        }

        i++;
    }
    return 0;
}

