// IN_RANGE: Verifica se valor está no intervalo [low, high]
template<typename T>
bool in_range(T value, T low, T high) {
    if(low <= value){
        if(value <= high){
        return true;
    }
}
    return false;
}

int16 main() {
    expected = in_range#int8(5, 1, 10);
    if(expected != true){
        return 1;
    }

    return 0; 
}