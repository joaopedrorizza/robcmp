// 1. abs - valor absoluto (com condicional ternário)
template <typename T>
T abs(T x) {
   
    if(x < 0){
        return -x;}
    else {
        return x;
    }
}

// 2. max - máximo entre dois valores
template <typename T>
T max(T a, T b) {
    
    if(a > b){
        return a;}
    else {
        return b;}
    
}

// 3. min - mínimo entre dois valores
template <typename T>
T min(T a, T b) {
   if(a < b){
    return a;}
    else {
    return b;}
}

